# Backend-only secrets. Keep this file separate from the shared root .env.
APP_ENV=development
DEBUG=true
MONGODB_URL=CHANGE_ME_TO_MONGODB_ATLAS_URI
MONGODB_DB_NAME=civiclens

# Production email: EMAIL_PROVIDER=brevo
EMAIL_PROVIDER=mock
BREVO_API_KEY=CHANGE_ME_TO_BREVO_API_KEY
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=CivicLens
BREVO_WEBHOOK_SECRET=CHANGE_ME

# Production OTP: SMS_PROVIDER=message_central
SMS_PROVIDER=mock
MESSAGE_CENTRAL_CUSTOMER_ID=CHANGE_ME
MESSAGE_CENTRAL_AUTH_TOKEN=CHANGE_ME
MESSAGE_CENTRAL_BASE_URL=https://cpaas.messagecentral.com

OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SESSION_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=5
ALLOW_RESOLUTION_WITHOUT_EVIDENCE=false
