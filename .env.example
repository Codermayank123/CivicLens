# =============================================================================
# CivicLens Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
APP_NAME=CivicLens
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# JWT Configuration
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Database (MongoDB Atlas / Secure MongoDB - Exclusively Required)
# -----------------------------------------------------------------------------
MONGODB_URL=CHANGE_ME_TO_MONGODB_ATLAS_URI
# MONGO_URI is accepted as an alternative name when MONGODB_URL is not set.
# MONGO_URI=
MONGODB_DB_NAME=civiclens

# -----------------------------------------------------------------------------
# Redis (Optional)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Keep false unless Redis is explicitly provisioned for queues/rate limiting.
REDIS_ENABLED=false

# -----------------------------------------------------------------------------
# Object Storage (S3-compatible / Private Bucket)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=civiclens-media
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/civiclens-media
# local (dev disk) | s3 (required in production)
STORAGE_BACKEND=local
BACKEND_PUBLIC_URL=http://localhost:8000
MEDIA_SIGNING_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_MEDIA_SECRET

# -----------------------------------------------------------------------------
# Identity verification (UIDAI — see https://uidai.gov.in/en/developer-section)
# -----------------------------------------------------------------------------
# development | disabled | uidai_sandbox | uidai_offline_ekyc
IDENTITY_PROVIDER=development
IDENTITY_CONSENT_VERSION=2026-01
# Keep false in production until UIDAI authorization, credentials, and E2E tests pass
CITIZEN_REGISTRATION_ENABLED=false
UIDAI_SANDBOX_AUTH_URL=https://developer.uidai.gov.in/authserver/2.5
UIDAI_SANDBOX_OTP_URL=https://developer.uidai.gov.in/uidotp/2.5
UIDAI_SANDBOX_EKYC_URL=https://developer.uidai.gov.in/uidkyc/kyc/2.5
UIDAI_AUA_CODE=
UIDAI_LICENSE_KEY=
UIDAI_OFFLINE_EKYC_CERT_PATH=

# -----------------------------------------------------------------------------
# AI Service
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8001
AI_MOCK_MODE=false
# When AI_MOCK_MODE=false (required in production):
AI_PROVIDER=openai_compatible
AI_API_KEY=CHANGE_ME_TO_PROVIDER_KEY
AI_API_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_REVIEW_CONFIDENCE_THRESHOLD=0.5

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# mock | smtp | resend | brevo
EMAIL_PROVIDER=brevo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
BREVO_API_KEY=CHANGE_ME_TO_BREVO_API_KEY
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=CivicLens
BREVO_WEBHOOK_SECRET=CHANGE_ME
EMAIL_FROM=noreply@civiclens.local
EMAIL_REPLY_TO=
FRONTEND_PUBLIC_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# SMS / OTP (production requires Message Central VerifyNow)
SMS_PROVIDER=message_central
MESSAGE_CENTRAL_CUSTOMER_ID=CHANGE_ME
MESSAGE_CENTRAL_AUTH_TOKEN=CHANGE_ME
MESSAGE_CENTRAL_BASE_URL=https://cpaas.messagecentral.com
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=+10000000000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_APP_NAME=CivicLens

# Structured India location catalog (JSON with states, districts and local areas)
INDIA_LOCATION_DATA_URL=CHANGE_ME_TO_APPROVED_INDIA_LOCATION_DATASET_URL
